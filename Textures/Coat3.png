<script>
const inputCanvas = document.getElementById('inputCanvas'),
outputCanvas = document.getElementById('outputCanvas'),
inputCtx = inputCanvas.getContext('2d'),
outputCtx = outputCanvas.getContext('2d');

const imageLoader = document.getElementById('imageLoader'),
dropzone = document.getElementById('dropzone'),
colorPicker = document.getElementById('colorPicker'),
replaceWithColor = document.getElementById('replaceWithColor'),
addColorBtn = document.getElementById('addColorBtn'),
colorList = document.getElementById('colorList'),
thresholdRange = document.getElementById('thresholdRange'),
thresholdValue = document.getElementById('thresholdValue'),
smoothEdges = document.getElementById('smoothEdges'),
undoBtn = document.getElementById('undoBtn'),
redoBtn = document.getElementById('redoBtn');

let img = null, colors = [], undoStack = [], redoStack = [];

dropzone.onclick = () => imageLoader.click();
dropzone.ondrop = e => { e.preventDefault(); handleFile(e.dataTransfer.files[0]); };
dropzone.ondragover = e => e.preventDefault();
imageLoader.onchange = e => handleFile(e.target.files[0]);

function handleFile(file){
const fr = new FileReader();
fr.onload = () => {
img = new Image();
img.onload = () => {
const cw = img.width;
const ch = img.height;

inputCanvas.width = cw;
inputCanvas.height = ch;
outputCanvas.width = cw;
outputCanvas.height = ch;

inputCtx.drawImage(img, 0, 0, cw, ch);
colors = [hexToRgb(colorPicker.value)];
updateColors(); process(); saveState();
};
img.src = fr.result;
};
fr.readAsDataURL(file);
}

addColorBtn.onclick = () => { colors.push(hexToRgb(colorPicker.value)); updateColors(); process(); };
thresholdRange.oninput = () => { thresholdValue.textContent = thresholdRange.value; process(); };
smoothEdges.onchange = process;
undoBtn.onclick = () => restore(undoStack, redoStack);
redoBtn.onclick = () => restore(redoStack, undoStack);

function updateColors(){
colorList.innerHTML = '';
colors.forEach((c, i) => {
const span = document.createElement('span');
span.style.backgroundColor = rgbToHex(c.r, c.g, c.b);
span.title = 'Click to remove';
span.onclick = () => {
colors.splice(i, 1); updateColors(); process();
};
colorList.appendChild(span);
});
}

function saveState(){
undoStack.push(outputCtx.getImageData(0, 0, outputCanvas.width, outputCanvas.height));
redoStack = [];
}

function restore(src, dst){
if(src.length){
dst.push(outputCtx.getImageData(0, 0, outputCanvas.width, outputCanvas.height));
const prev = src.pop();
outputCtx.putImageData(prev, 0, 0);
}
}

function process(){
if(!img) return;
saveState();

const w = inputCanvas.width;
const h = inputCanvas.height;

inputCtx.clearRect(0, 0, w, h);
inputCtx.drawImage(img, 0, 0, w, h);

const src = inputCtx.getImageData(0, 0, w, h),
  out = inputCtx.createImageData(src);
out.data.set(src.data);

const t = +thresholdRange.value;
const replacement = hexToRgb(replaceWithColor.value);

colors.forEach(col => {
for(let y = 0; y < h; y++) {
for(let x = 0; x < w; x++) {
  const i = (y * w + x) * 4;
  const d = colorDist(col, out.data[i], out.data[i+1], out.data[i+2]);
  if(d < t){
    if(smoothEdges.checked){
      const ratio = d / t;
      out.data[i]   = lerp(out.data[i], replacement.r, 1 - ratio);
      out.data[i+1] = lerp(out.data[i+1], replacement.g, 1 - ratio);
      out.data[i+2] = lerp(out.data[i+2], replacement.b, 1 - ratio);
    } else {
      out.data[i]   = replacement.r;
      out.data[i+1] = replacement.g;
      out.data[i+2] = replacement.b;
    }
  }
}
}
});

outputCtx.clearRect(0, 0, w, h);
outputCtx.putImageData(out, 0, 0);
}

function colorDist(c, a, b, d){
return Math.sqrt((c.r - a)**2 + (c.g - b)**2 + (c.b - d)**2);
}

function rgbToHex(r, g, b){
return '#' + [r, g, b].map(n => n.toString(16).padStart(2, '0')).join('');
}

function hexToRgb(h){
h = h.replace('#','');
return {
r: parseInt(h.slice(0,2),16),
g: parseInt(h.slice(2,4),16),
b: parseInt(h.slice(4,6),16)
};
}

function lerp(a, b, t){
return Math.round(a + (b - a) * t);
}

</script>            
            
