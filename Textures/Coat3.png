    <script>
        const DOWNLOAD_LIMIT = 10;
        const TOOL_KEY = 'download_count_change-png-color';
        const LOGIN_KEY = 'user_logged_in';

        const USERS = {
            "user1": "482c811da5d5b4bc6d497ffa98491e38",
            "john": "202cb962ac59075b964b07152d234b70",
            "fabin": "4aba99f427fdf063b7073aea4afaf2d9",            
            "zander": "98e975a8ad1e375774bd350a7ab86e27",
            "eric": "29a125dd94692840bbaee0bae0b563de",
            "wstone": "a88c8d0a64bce4094ee92e2c519db8d4",
            "cole": "e29e16c4c4df5c332f87583939463079",            
            "mike": "08ed91e3dd6db1abd9f558e722847e59",
            "jessica": "b6c174a2a4dc5dbd2206e7fc020e5845",           
            "demo": "098f6bcd4621d373cade4e832627b4f6"
        };

        function md5(string) {
            return CryptoJS.MD5(string).toString();
        }

        function getTodayKey() {
            const today = new Date().toISOString().split('T')[0]; // YYYY-MM-DD
            return `${TOOL_KEY}_${today}`;
        }

        function getDownloadCount() {
            const key = getTodayKey();
            return parseInt(localStorage.getItem(key)) || 0;
        }

        function setDownloadCount(count) {
            const key = getTodayKey();
            localStorage.setItem(key, count);
        }

        function isUserLoggedIn() {
            return localStorage.getItem(LOGIN_KEY) || null;
        }

        function updateLoggedUserDisplay() {
            const user = isUserLoggedIn();
            //document.getElementById('loggedUser').innerText = user ? user : 'Guest';
            document.getElementById('login-user').innerHTML = user ? '<a href="#" onclick="logout()" class="btn btn-primary" style="color:#ffffff;">Log Out</a>' : '<a href="#" onclick="openLoginModal()" class="btn btn-primary" style="color:#ffffff;">Sign In</a>';
        
        }

        function onDownloadButtonClick() {
            if (isUserLoggedIn()) {
                startDownload();
                return;
            }

            const count = getDownloadCount();
            const remaining = DOWNLOAD_LIMIT - count;

            if (remaining <= 0) {
                document.getElementById('modalTitle').innerText = 'Free plan limit reached!';
                document.getElementById('modalText').innerHTML = "You've reached the daily free plan limit. Login or upgrade to remove limits.";
                document.getElementById('downloadBtn').disabled = true;
                document.getElementById('remainingQuota').innerText = `Remaining downloads for today: 0`;
            } else {
                document.getElementById('modalTitle').innerText = "You're using the free plan";
                document.getElementById('modalText').innerHTML = "The free plan lets you use PNG tools for <b>personal use only</b>. Upgrade or login to remove limits and unlock premium features.";
                document.getElementById('downloadBtn').disabled = false;
                document.getElementById('remainingQuota').innerText = `Remaining downloads for today: ${remaining}`;
            }

            document.getElementById('downloadModal').style.display = 'block';
        }

        function closeModal() {
            document.getElementById('downloadModal').style.display = 'none';
        }

        function confirmDownload() {
            if (isUserLoggedIn()) {
                closeModal();
                startDownload();
                return;
            }

            const count = getDownloadCount();

            if (count >= DOWNLOAD_LIMIT) {
                alert("Free plan limit reached for today.");
                closeModal();
                return;
            }

            const newCount = count + 1;
            setDownloadCount(newCount);

            closeModal();
            startDownload();
        }

        function startDownload() {
      	  const a=document.createElement('a');
    	  a.download='output-smallpngtools.png';
    	  a.href=outputCanvas.toDataURL();
    	  a.click();
        }

        // Login Modal Functions
        function openLoginModal() {
            document.getElementById('loginModal').style.display = 'block';
            document.getElementById('loginError').style.display = 'none';
        }

        function closeLoginModal() {
            document.getElementById('loginModal').style.display = 'none';
        }

        function performLogin() {
            const username = document.getElementById('loginUsername').value.trim();
            const password = document.getElementById('loginPassword').value.trim();
            const passwordHash = md5(password);

            if (USERS[username] && USERS[username] === passwordHash) {
                localStorage.setItem(LOGIN_KEY, username);
                closeLoginModal();
                closeModal();
                alert(`Welcome ${username}! You are logged in.`);
                updateLoggedUserDisplay();
               // startDownload();
            } else {
                document.getElementById('loginError').style.display = 'block';
            }
        }

        function logout() {
            localStorage.removeItem(LOGIN_KEY);
            alert("You are logged out.");
            updateLoggedUserDisplay();
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            updateLoggedUserDisplay();
        });
        
        document.getElementById("outputCanvas").addEventListener("contextmenu", function(e) {
            e.preventDefault();
        });

        const canvas = document.getElementById("outputCanvas");
        canvas.style.pointerEvents = "none";       
